# Copy this file to .env.local (git ignores it) and fill in both values from your Supabase project:
# Project Settings > API. Never put the secret or service_role key in any file in this repository.
#
# The publishable key is meant for browsers. It can only do what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY
