# Copy to .env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection. Replace USER, PASSWORD and the database name.
DATABASE_URL=postgres://nagorik:123456789012@localhost:5432/nagorikpass
# Set to true when the database requires TLS, as most hosted providers do.
DATABASE_SSL=false

# Browser origin of the frontend. Used for CORS, CSRF checks and links in emails.
FRONTEND_ORIGIN=http://localhost:5173

# Decides what "today" means for visits and reports.
APP_TIMEZONE=Asia/Dhaka

# Sign-in session length, without and with "Remember me".
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30

# Sign-in attempts allowed per IP address and email in 15 minutes.
LOGIN_RATE_LIMIT_MAX=10

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# How email is delivered:
# smtp:    send through the SMTP server configured below.
# mailbox: keep emails in memory and show them at /api/dev/mailbox. No credentials needed. Development only.
# console: print emails to the server log. Development only.
# none:    record notifications as pending without delivering them.
EMAIL_TRANSPORT=mailbox

# Used only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=
# 587 for STARTTLS, 465 for TLS from the start.
SMTP_PORT=587
# Blank means true on port 465 and false otherwise.
SMTP_SECURE=
# Refuse to send without encryption. Blank means true when a username is set.
SMTP_REQUIRE_TLS=
# Leave both blank for a server that needs no sign-in, such as Mailpit.
SMTP_USER=
SMTP_PASSWORD=
# The sender address. The sender name comes from Settings in the application.
SMTP_FROM_ADDRESS=

# Read only by the seed commands. Remove them from the environment after seeding.
# Passwords must be at least 12 characters.
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=123456789012

SEED_RECEPTIONIST_EMAIL=reception@example.com
SEED_RECEPTIONIST_PASSWORD=123456789012
